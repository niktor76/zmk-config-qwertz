#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <locale/keys_de.h>

/ {
  /* ---- Custom behaviors: tap = letter, hold = umlaut ----
   * NOTE: bindings are behaviors WITHOUT parameters; we pass parameters at use time.
   */
  behaviors {
    a_or_ae: a_or_ae {
      compatible = "zmk,behavior-hold-tap";
      label = "A_or_AE";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <200>;
      bindings = <&kp &kp>; /* hold behavior, tap behavior (params supplied at use) */
    };

    o_or_oe: o_or_oe {
      compatible = "zmk,behavior-hold-tap";
      label = "O_or_OE";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <200>;
      bindings = <&kp &kp>;
    };

    u_or_ue: u_or_ue {
      compatible = "zmk,behavior-hold-tap";
      label = "U_or_UE";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <200>;
      bindings = <&kp &kp>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    /* ---------------------- Default Layer ---------------------- */
    default_layer {
      display-name = "Default Layer";
      // -----------------------------------------------------------------------------------------
      // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Z  |  U   |  I  |  O  |  P  | BSPC |
      // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
      // | SHFT |  Y  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
      //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
      bindings = <
        &kp TAB   &kp Q             &kp W     &kp E     &kp R     &kp T
                    &kp Z           &u_or_ue DE_UE U   &kp I     &o_or_oe DE_OE O   &kp P     &kp BSPC

        &kp LCTRL   &a_or_ae DE_AE A  &kp S     &kp D     &kp F     &kp G
                    &kp H             &kp J     &kp K     &kp L     &kp SEMI  &kp DE_SS

        &kp LSHFT   &kp Y             &kp X     &kp C     &kp V     &kp B
                    &kp N             &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp ESC

                           &kp LGUI   &mo 1     &kp SPACE             &kp RET   &mo 2    &kp RALT
      >;
    };

    /* ---------------------- Lower Layer ---------------------- */
    lower_layer {
      display-name = "Lower Layer";
      bindings = <
        &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5
                    &kp N6      &kp N7       &kp N8       &kp N9       &kp N0    &kp BSPC

        &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                    &kp LEFT    &kp DOWN     &kp UP       &kp RIGHT    &trans    &trans

        &kp LSHFT   &trans      &trans       &trans       &trans       &trans
                    &trans      &trans       &trans       &trans       &trans    &trans

                           &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
      >;
    };

    /* ---------------------- Raise Layer ---------------------- */
    raise_layer {
      display-name = "Raise Layer";
      bindings = <
        &kp TAB   &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT
                    &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC

        &kp LCTRL &trans   &trans   &trans   &trans   &trans
                    &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE

        &kp LSHFT &trans   &trans   &trans   &trans   &trans
                    &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE

                              &kp LGUI &trans &kp SPACE   &kp RET   &trans    &kp RALT
      >;
    };
  };
};